meta {
  name: Refuser un événement invalide
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/events
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": " ",
    "date": "2000-01-01T20:00:00",
    "capacity": 0,
    "basePrice": 0
  }
}

tests {
  test("validation : 400 avec les champs fautifs", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().fieldErrors).to.have.property("name");
    expect(res.getBody().fieldErrors).to.have.property("date");
    expect(res.getBody().fieldErrors).to.have.property("capacity");
    expect(res.getBody().fieldErrors).to.have.property("basePrice");
  });
}
